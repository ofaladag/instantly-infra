#!/usr/bin/env bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
# No apt/cloud-init package module before this: DATA has no public route initially.
cat > /etc/systemd/system/instantly-route.service <<'UNIT'
[Unit]
Description=Instantly private-only default route
Wants=network-online.target
After=network-online.target
Before=docker.service
[Service]
Type=oneshot
ExecStart=/usr/sbin/ip route replace default via ${gateway}
RemainAfterExit=yes
[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now instantly-route.service
# Explicit bootstrap resolvers; CoreDNS need not be running to install dependencies.
mkdir -p /etc/systemd/resolved.conf.d
printf '[Resolve]\nDNS=1.1.1.1 9.9.9.9\n' > /etc/systemd/resolved.conf.d/instantly.conf
systemctl restart systemd-resolved
# APP cloud-init and NAT may still be starting. Bound retries to ~15 minutes plus apt timeouts.
ready=false
for attempt in $(seq 1 45); do
  if apt-get -o Acquire::http::Timeout=10 -o Acquire::https::Timeout=10 -o APT::Update::Error-Mode=any update; then ready=true; break; fi
  sleep 20
done
$ready || { echo 'APP NAT is unavailable; inspect APP cloud-init and retry this script.' >&2; exit 1; }
apt-get -o Acquire::Retries=10 install -y nftables ca-certificates curl
cat > /etc/systemd/system/instantly-data-firewall.service <<'UNIT'
[Unit]
Description=Instantly private host and Docker ingress firewall
Wants=network-online.target
After=network-online.target instantly-route.service
Before=docker.service
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/instantly-data-firewall
RemainAfterExit=yes
[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now instantly-data-firewall.service
# Volume attaches after server creation. Never format an existing device here.
device=/dev/disk/by-id/scsi-0HC_Volume_${volume_id}
for attempt in $(seq 1 120); do
  if [ -b "$device" ] && [ "$(blkid -s TYPE -o value "$device")" = ext4 ]; then break; fi
  sleep 5
done
test -b "$device"
test "$(blkid -s TYPE -o value "$device")" = ext4
mkdir -p /data/instantly
cat > /etc/systemd/system/data-instantly.mount <<'UNIT'
[Unit]
Description=Instantly persistent database volume
Before=docker.service
[Mount]
What=/dev/disk/by-id/scsi-0HC_Volume_${volume_id}
Where=/data/instantly
Type=ext4
Options=defaults,noatime
[Install]
WantedBy=multi-user.target
UNIT
mkdir -p /etc/systemd/system/docker.service.d
cat > /etc/systemd/system/docker.service.d/20-instantly-data.conf <<'UNIT'
[Unit]
Requires=instantly-route.service instantly-data-firewall.service
After=instantly-route.service instantly-data-firewall.service
RequiresMountsFor=/data/instantly
UNIT
systemctl daemon-reload
systemctl enable --now data-instantly.mount
install -d -m 0750 /data/instantly/postgres /data/instantly/redis /data/instantly/backups
# Coolify installs Docker while validating this server. No databases are created here.
touch /var/lib/instantly-bootstrap-complete
