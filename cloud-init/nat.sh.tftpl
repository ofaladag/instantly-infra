#!/usr/bin/env bash
set -euo pipefail
public_if=$(ip -4 route show default | awk 'NR==1 {print $5}')
test -n "$public_if"
sysctl -w net.ipv4.ip_forward=1
# Insert dedicated rules ahead of Docker's FORWARD policy, also after Docker restarts.
iptables -w -t nat -C POSTROUTING -s ${data_ip}/32 -o "$public_if" -j MASQUERADE 2>/dev/null || iptables -w -t nat -A POSTROUTING -s ${data_ip}/32 -o "$public_if" -j MASQUERADE
iptables -w -C FORWARD -s ${data_ip}/32 -o "$public_if" -j ACCEPT 2>/dev/null || iptables -w -I FORWARD 1 -s ${data_ip}/32 -o "$public_if" -j ACCEPT
iptables -w -C FORWARD -d ${data_ip}/32 -i "$public_if" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || iptables -w -I FORWARD 1 -d ${data_ip}/32 -i "$public_if" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
iptables -w -t mangle -C FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null || iptables -w -t mangle -A FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
