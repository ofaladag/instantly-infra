# STG: copy to terraform.tfvars (gitignored); replace ALL placeholders.
# Environment is fixed in main.tf; do not set an environment variable here.
project = "instantly"
domain = "example.com"
cloudflare_zone_id = "REPLACE_WITH_ZONE_ID"
ssh_public_keys = {
  operator = "ssh-ed25519 REPLACE_WITH_ADMIN_PUBLIC_KEY"
}
coolify_ssh_public_key = "ssh-ed25519 REPLACE_WITH_COOLIFY_PUBLIC_KEY"
admin_ipv4_cidrs = ["203.0.113.10/32"] # Replace with your actual public IP.
location = "fsn1"
network_zone = "eu-central"
app_server_type = "cx23"
data_server_type = "cx23"
# No additional volume in stg; data uses DATA-01 root disk.
server_backups = true
# Explicit opt-in: executes the current upstream Coolify install script at first boot.
install_coolify = false
public_app_subdomains = ["api"]
